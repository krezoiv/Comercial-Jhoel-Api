  opt !isPasswordValid
    UC0-->>G: InvalidCredentialsError()
  end
  opt !user.isActive
    UC0-->>G: InvalidCredentialsError()
  end
  UC0->>R0: findByUsernameOrPhone()
  R0-->>UC0: datos
  UC0->>R1: compare()
