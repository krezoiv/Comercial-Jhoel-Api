# In production (Railway) set this to `production` — some behavior (error
# detail exposure, etc.) is deliberately stricter when NODE_ENV=production.
NODE_ENV=development
# Railway injects its own PORT at runtime — this fallback is for local use only.
PORT=3000

# Local values below. In Railway, set these to reference the Postgres
# service's own variables instead of copying values by hand, e.g.:
#   DATABASE_HOST=${{Postgres.PGHOST}}
#   DATABASE_PORT=${{Postgres.PGPORT}}
#   DATABASE_USERNAME=${{Postgres.PGUSER}}
#   DATABASE_PASSWORD=${{Postgres.PGPASSWORD}}
#   DATABASE_NAME=${{Postgres.PGDATABASE}}
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=kzi
DATABASE_PASSWORD=krezoiv1984/
DATABASE_NAME=comercial_jhoel

# In production, generate a real random secret (e.g. `openssl rand -base64 48`)
# and set it only as a Railway service variable — never commit a real value here.
JWT_SECRET=change-me
JWT_EXPIRES_IN=86400

# Comma-separated. An entry with `*` is matched as a wildcard (e.g. for
# temporary VS Code Ports/Codespaces sharing): CORS_ORIGINS=http://localhost:4200,https://*.app.github.dev
# In production, set this to the real frontend domain only, e.g.:
#   CORS_ORIGINS=https://<frontend-service>.up.railway.app
CORS_ORIGINS=http://localhost:4200

SEED_ADMIN_EMAIL=admin@comercialjhoel.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PHONE=00000000
SEED_ADMIN_PASSWORD=admin123
